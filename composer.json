{
    "name": "leopoletto/robots-txt-parser",
    "description": "A comprehensive PHP package for parsing robots.txt files, including support for meta tags and X-Robots-Tag HTTP headers",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Leonardo Poletto",
            "email": "hello@leopoletto.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "guzzlehttp/guzzle": "^7.5",
        "psr/http-message": "^1.1|^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "friendsofphp/php-cs-fixer": "^3.21.1",
        "phpstan/phpstan": "^2.1"
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-text",
        "phpstan": "vendor/bin/phpstan analyse --memory-limit=1G",
        "format": "vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.dist.php --allow-risky=yes",
        "format:check": "vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.dist.php --allow-risky=yes --dry-run --diff",
        "agents:build": "php bin/build-agents.php",
        "agents:sync": "php bin/sync-agents.php",
        "quality": [
            "@format:check",
            "@phpstan",
            "@test"
        ],
        "crawlers:import": "php bin/import-crawlers.php"
    },
    "autoload": {
        "psr-4": {
            "Leopoletto\\RobotsTxtParser\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Leopoletto\\RobotsTxtParser\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.2.0"
        }
    }
}
